generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Workspace {
  id        String @id
  expiresAt DateTime
  accounts Account[]
  transactions Transaction[]
  templates FinanceTemplate[]
  audit AuditEvent[]
  @@index([expiresAt])
}
model Account {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  geo String
  owner String
  dailyLimit Int @default(0)
  quality String @default("Не оценено")
  proxyProvider String @default("")
  cardBin String @default("")
  warmupScheme String @default("")
  additionalFarming Boolean @default(false)
  status String @default("Прогрев")
  createdAt DateTime @default(now())
  history AccountEvent[]
  limitHistory AccountLimitEvent[]
  @@index([workspaceId, createdAt])
}
model AccountEvent {
  id String @id @default(cuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  previousStatus String?
  status String
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}
model AccountLimitEvent {
  id String @id @default(cuid())
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  limit Int
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}
model Transaction {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  kind String
  department String @default("GENERAL")
  amount Int
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model FinanceTemplate {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  kind String
  department String
  amount Int
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model AuditEvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action String
  title String
  amount Int
  entityType String @default("finance")
  oldValue String?
  newValue String?
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
